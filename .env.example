# =====================================================================
#  Parkirek - Contoh Environment (salin -> .env)
#
#      cp .env.example .env      (Linux/macOS)
#      copy .env.example .env    (Windows PowerShell)
#
#  File .env berisi RAHASIA (password, APP_KEY) dan TIDAK boleh
#  di-commit ke repository. File ini sudah tercakup di .gitignore.
# =====================================================================

# ---------- Aplikasi ----------
APP_NAME=Parkirek
APP_ENV=production
# Ganti dengan hasil: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# UBAH menjadi http://<IP_PUBLIC_VM> saat deploy ke Azure VM
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Jakarta

# ---------- Logging ----------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ---------- Database (layanan internal "db" pada compose.yaml) ----------
DB_CONNECTION=mysql
# "db" = nama service database pada jaringan internal Docker.
# Jalankan di luar Docker (php artisan serve)? gunakan 127.0.0.1
DB_HOST=db
DB_PORT=3306
DB_DATABASE=parkirek
# WAJIB user MySQL non-root (image MySQL menolak MYSQL_USER=root)
DB_USERNAME=parkirek
DB_PASSWORD=

# Password root MySQL (hanya dipakai di dalam container database).
# Kosongkan -> compose memakai DB_PASSWORD sebagai password root.
MYSQL_ROOT_PASSWORD=

# ---------- Port publik aplikasi ----------
APP_PORT=80

# ---------- Session / Cache / Queue / Filesystem ----------
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
